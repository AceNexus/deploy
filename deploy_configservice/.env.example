# 使用方式：複製此檔案為 .env，並填入實際值

# 安全設定
SECURITY_USERNAME=admin
SECURITY_PASSWORD=your_password_here

# 加密設定（用於 Config Server 加解密屬性值）
ENCRYPT_KEY=your_encrypt_key_here

# RabbitMQ 管理員帳號設定（用於建立 RabbitMQ 使用者）
RABBITMQ_USER=admin
RABBITMQ_PASS=your_rabbitmq_password_here

# 分散式追蹤設定（選填）
# 預設停用（0.0）；若啟動 start_deploy_tempo.bat 後可設為 1.0 以將 trace 送至 Tempo
TRACING_SAMPLING_PROBABILITY=0.0
# MANAGEMENT_OTLP_TRACING_ENDPOINT=http://tempo:4318/v1/traces
