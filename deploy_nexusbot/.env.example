# 使用方式：複製此檔案為 .env，並填入實際值

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# 伺服器設定
SERVER_HOST=0.0.0.0
SERVER_PORT=5001

# NexusBot 對外 URL（啟動 ngrok 後填入，例如 https://xxxx.ngrok-free.app）
NEXUSBOT_BASE_URL=

# Config Server 設定
CONFIG_SERVER_URI=http://configservice:8888
CONFIG_SERVER_USERNAME=
CONFIG_SERVER_PASSWORD=

# MySQL 資料庫設定
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=nexusbot
MYSQL_USERNAME=
MYSQL_PASSWORD=

# RabbitMQ 設定
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Eureka 服務發現設定
EUREKA_SERVER_HOST=eurekaservice
EUREKA_SERVER_PORT=8761

# LINE Bot 設定
# 取得網址: https://developers.line.biz/console/ -> Messaging API -> Channel access token / Channel secret
LINE_CHANNEL_TOKEN=
LINE_CHANNEL_SECRET=

# Groq AI API 設定
# 取得網址: https://console.groq.com/keys
GROQ_API_KEY=

# Email 通知設定（建議使用 Gmail App Password）
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=NexusBot 提醒通知

# 管理員密碼種子（用於產生初始管理員帳號密碼）
ADMIN_PASSWORD_SEED=

# Groq 模型設定（選填，預設 llama-3.1-8b-instant）
GROQ_DEFAULT_MODEL=

# 預設時區設定（選填，預設 Asia/Taipei，IANA 時區 ID）
DEFAULT_TIMEZONE=Asia/Taipei
