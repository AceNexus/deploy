SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

SECURITY_USERNAME=admin
SECURITY_PASSWORD=password

# 容器內透過 host.docker.internal 連回宿主機上的 Config Server
CONFIG_SERVER_URI=http://host.docker.internal:8888
CONFIG_SERVER_USERNAME=admin
CONFIG_SERVER_PASSWORD=password

# 容器內透過 host.docker.internal 連回宿主機上的 Eureka Server
EUREKA_SERVER_HOST=host.docker.internal
EUREKA_SERVER_PORT=8761

# RabbitMQ 由 deploy_configservice 的 docker-compose 啟動，對外暴露 5672
# 容器內透過 host.docker.internal 連回宿主機
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=password

