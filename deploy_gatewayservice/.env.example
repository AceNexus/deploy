# 使用方式：複製此檔案為 .env，並填入實際值

# 伺服器設定
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# 安全設定
SECURITY_USERNAME=admin
SECURITY_PASSWORD=your_password_here

# Config Server 設定
CONFIG_SERVER_URI=http://configservice:8888
CONFIG_SERVER_USERNAME=admin
CONFIG_SERVER_PASSWORD=your_password_here

# Eureka 服務發現設定
EUREKA_SERVER_HOST=eurekaservice
EUREKA_SERVER_PORT=8761

# RabbitMQ 設定
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=your_password_here

# JWT 設定（建議使用 Base64 編碼的隨機字串，至少 256 bits）
JWT_SECRET=your_jwt_secret_here
